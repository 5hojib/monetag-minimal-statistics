<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent balance widget: today / yesterday / total, left-aligned.
     The total balance is the large figure; a refresh button sits on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <TextView
            android:id="@+id/widget_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_today_label"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:textStyle="normal"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/widget_today_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="sans"
            android:fontFamily="sans-serif"
            android:textIsSelectable="false" />

        <TextView
            android:id="@+id/widget_yesterday_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_yesterday_label"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/widget_yesterday_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="sans"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/widget_balance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/widget_total_label"
            android:textColor="#9CA3AF"
            android:textSize="10sp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/widget_balance_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:typeface="sans"
            android:fontFamily="sans-serif"
            android:maxLines="1" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_refresh"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_refresh"
        android:background="@null"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="@string/widget_refresh" />
</LinearLayout>